# Option A (simple): provide a full connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/pubsub_assignment

# Option B (Atlas, safer): provide parts; the server will URL-encode the password.
# MONGODB_ATLAS_HOST=cluster0.xxxxx.mongodb.net
# MONGODB_ATLAS_USER=myUser
# MONGODB_ATLAS_PASSWORD=myRawPasswordWithSpecialChars
# MONGODB_DBNAME=pubsub_assignment
PORT=4000
POLL_INTERVAL_MS=200
SUBSCRIBER_QUEUE_MAX=2000

